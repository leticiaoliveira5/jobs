<%= render(BoxComponent.new) do |component| %>
  <% component.with_title { "Edit #{resource_name.to_s.humanize}" } %>
  <% component.with_body do %>
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name),
                        html: { method: :put, class: 'row gx-3' }) do |f| %>
      <%= f.input :firstname, wrapper_html: { class: 'col-12 col-md-6' } %>
      <%= f.input :surname,   wrapper_html: { class: 'col-12 col-md-6' } %>

      <% if candidate_signed_in? %>
        <%= f.input :about_me, as: :text, wrapper_html: { class: 'col-12' } %>
        <%= f.input :document, wrapper_html: { class: 'col-12 col-md-6' } %>
        <%= f.input :website,  wrapper_html: { class: 'col-12 col-md-6' } %>
        <%= f.input :avatar, input_html: { accept: ['image/jpeg'] }, wrapper_html: { class: 'col-12' } %>

        <%= f.fields_for :address, resource.address || resource.build_address do |af| %>
          <%= af.input :zipcode,      wrapper_html: { class: 'col-12 col-md-4' } %>
          <%= af.input :street,       wrapper_html: { class: 'col-12 col-md-8' } %>
          <%= af.input :number,       wrapper_html: { class: 'col-4 col-md-3' } %>
          <%= af.input :neighborhood, wrapper_html: { class: 'col-8 col-md-9' } %>
          <%= af.input :city,         wrapper_html: { class: 'col-12 col-md-6' } %>
          <%= af.input :country, as: :string, wrapper_html: { class: 'col-12 col-md-6' } %>
        <% end %>
      <% end %>

      <%= f.input :email, as: :email, autofocus: true, autocomplete: 'email',
                          wrapper_html: { class: 'col-12' } %>

      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <div class="col-12 mb-3">Currently waiting confirmation for: <%= resource.unconfirmed_email %></div>
      <% end %>

      <p class="col-12 fst-italic text-body-secondary">Leave password blank if you don't want to change it</p>

      <%= f.input :password, as: :password, autocomplete: 'new-password',
                             hint: (@minimum_password_length && "#{@minimum_password_length} characters minimum"),
                             wrapper_html: { class: 'col-12 col-md-6' } %>
      <%= f.input :password_confirmation, as: :password, autocomplete: 'new-password',
                                          wrapper_html: { class: 'col-12 col-md-6' } %>

      <p class="col-12 fst-italic text-body-secondary">We need your current password to confirm your changes</p>

      <%= f.input :current_password, as: :password, autocomplete: 'current-password',
                                     wrapper_html: { class: 'col-12 col-md-6' } %>

      <div class="col-12 d-grid d-md-block">
        <%= f.button :submit, 'Update', class: 'btn btn-primary' %>
      </div>
    <% end %>
  <% end %>
<% end %>

<%= render(BoxComponent.new) do |component| %>
  <% component.with_title { 'Delete my account' } %>
  <% component.with_body do %>
    <%= button_to 'Cancel my account', registration_path(resource_name),
                  method: :delete, class: 'btn btn-danger',
                  data: { confirm: 'Are you sure?' } %>

    <div class="mt-3"><%= back_button %></div>
  <% end %>
<% end %>
