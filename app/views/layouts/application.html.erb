<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:html_title) ? yield(:html_title) : "Jobs" %></title>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_include_tag 'application' %>
  </head>

  <body>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500&display=swap" rel="stylesheet">

    <%= render(NavbarComponent.new(title: 'Jobs')) do |nav| %>
      <% nav.with_left do %>
        <% nav_links %>
      <% end %>
      <% nav.with_right do %>
        <% employee_nav_links %>
        <% candidate_nav_links %>
      <% end %>
    <% end %>

    <% if notice %>
      <p class="mb-4 rounded-sm border border-green-300 bg-green-100 p-4 text-green-800"><%= notice %></p>
    <% end %>
    <% if alert %>
      <p class="mb-4 rounded-sm border border-red-300 bg-red-100 p-4 text-red-800"><%= alert %></p>
    <% end %>

    <div class="container mx-auto px-3">
      <%= yield %>
    </div>

  </body>
</html>
