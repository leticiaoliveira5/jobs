<div class="login-container">
  <div class="m-auto w-100 overflow-hidden m-5 bg-body-secondary rounded">
    <%= render(TabsComponent.new(tabs: [
      { id: 'candidate-form', title: t('activerecord.models.candidate.one'), content: render('form', resource_name: 'candidate') },
      { id: 'employee-form', title: t('activerecord.models.company.one'), content: render('form', resource_name: 'employee') }
    ])) %>
  </div>
</div>

<style>
  /* large screen */
  @media screen and (min-device-width: 750px) and (min-width: 750px) {
    body {
      background-image: url('<%= asset_path HomeController.random_background_image %>');
      background-repeat: no-repeat;
      background-size: cover;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100vh;
    }

    .container {
      margin: auto;
      width: 80%;
    }

    .login-container {
      float: right;
    }
  }

  /* small screen  */
  @media screen and (max-device-width: 750px) and (max-width: 750px) {
    .container {
      width: 95%;
      margin: auto;
    }
  }
</style>