<%= form_for(resource_name, url: session_path(resource_name)) do |f| %>
  <div class="form-group">
    <%= f.label :email, t("activerecord.attributes.#{resource_name}.email"), class: 'form-label d-block fs-5 text-start text-lowercase' %>
    <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'form-control form-control-lg w-100 my-3 rounded' %>
    <%= f.label :password, t("activerecord.attributes.#{resource_name}.password"), autocomplete: "current-password", class: 'form-label d-block fs-5 text-start text-lowercase' %>
    <%= f.password_field :password, class: 'form-control form-control-lg w-100 my-3 rounded' %>
    <%= link_to t('devise.passwords.new.forgot_your_password'), new_password_path(resource_name), class: 'float-end small' %>
  </div>
  <div>
    <%= f.submit t('devise.sessions.new.sign_in'), class: 'btn border-0 fs-4 fw-bold w-100 my-3 text-primary rounded' %><br>
    <span class='checkbox-field'>
      <%= f.label(:remember_me, class: 'd-inline text-none') do %>
        <%= f.check_box(:remember_me, class: 'align-middle') %>
        <%= t('devise.labels.remember_me') %>
      <% end %>
    </span>
  </div>
  <div>
    <%= t('home.index.or_create_an_account') %><br>
    <%= link_to t('devise.registrations.new.sign_up'), new_registration_path(resource_name), class: 'fw-bold text-decoration-none' %>
  </div>
<% end %>

<style>
.checkbox-field label { font-size: 12px; }
</style>
