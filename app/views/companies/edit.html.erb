<% content_for(:html_title) { t('.title') } %>

<%= render(BoxComponent.new) do |box| %>
  <%= box.with_title { t('.title') } %>
  <%= box.with_body do %>
    <%= simple_form_for(@company) do |f| %>
      <%= f.input :name %>
      <%= f.input :domain %>
      <%= f.input :document %>
      <%= f.input :logo, input_html: { accept: ['image/png'] } %>

      <%= f.fields_for :address do |af| %>
        <%= af.input :zipcode %>
        <%= af.input :street %>
        <%= af.input :number %>
        <%= af.input :neighborhood %>
        <%= af.input :city %>
        <%= af.input :country, as: :string %>
      <% end %>

      <%= f.button :submit, 'Cadastrar empresa' %>
    <% end %>

    <%= back_button %>
  <% end %>
<% end %>
