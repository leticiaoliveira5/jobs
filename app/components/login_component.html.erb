<div class="login-component m-auto w-100 overflow-hidden m-5 bg-body-secondary rounded">
  <div class="tabs">
    <div class="tab" onclick="showTab(event, 'candidate-form')" id="defaultOpen">
      <%= t('activerecord.models.candidate.one') %>
    </div> 
    <div class="tab" onclick="showTab(event, 'employee-form')">
      <%= t('activerecord.models.company.one') %>
    </div>
  </div>
  <div class="tabcontent" id="candidate-form">
    <%= render 'form', resource_name: 'candidate' %>
  </div>
  <div class="tabcontent" id="employee-form">
    <%= render 'form', resource_name: 'employee' %>
  </div>
</div>

<script>
  document.getElementById("defaultOpen").click();

  function showTab(evt, tabName) {
  var i, tabcontent, tab;

  tabcontent = document.getElementsByClassName("tabcontent");
  for (i = 0; i < tabcontent.length; i++) {
    tabcontent[i].style.display = "none";
  }

  tab = document.getElementsByClassName("tab");
  for (i = 0; i < tab.length; i++) {
    tab[i].className = tab[i].className.replace(" active", "");
  }

  document.getElementById(tabName).style.display = "block";
  evt.currentTarget.className += " active";
}
</script>

<style>

.login-component {}
.login-component .tabs {
  display: flex;
  flex-direction: row;
  margin-bottom: 15px;
  width: 100%;
}
.login-component .tab {
  border-bottom: 3px solid;
  color: #818181;
  cursor: pointer;
  font-size: 1.6em;
  font-weight: 500;
  letter-spacing: 0;
  padding: 20px 0 5px 0;
  text-align: center;
  width: 50%;
}
.login-component .tabs .active {
  border-color: #276a66;
  color: #276a66;
  font-weight: 500;
  letter-spacing: 0.05em;
}
.login-component .tabcontent {
  margin: auto;
  width: 85%;
}
.login-component .tabcontent div {
  font-size: 20px;
  margin: 1em auto;
  padding: 18px;
  text-align: center;
}
.login-component .btn {
  font-size: 24px;
  padding: 5px;
}
.login-component input[type=email],
.login-component input[type=password] {
  border-radius: 7px;
  font-size: 18px;
  margin: 15px 0;
  padding: 15px 20px;
  width: 100%;
}
.login-component input[type=submit] {
  border: none;
  color: #276a66;
  cursor: pointer;
  font-family: 'Montserrat', sans-serif;
  font-size: 24px;
  font-weight: 700;
}
.login-component input[type="checkbox"] { vertical-align: middle; }
.login-component label {
  display: block;
  font-size: 20px;
  margin-bottom: -10px;
  text-align: left;
  text-transform: lowercase;
}
.login-component .hint-link {
  float: right;
  font-size: 12px;
  margin-top: -10px;
}
.login-component .checkbox-field label {
  display: inline;
  font-size: 12px;
  text-transform: none;
}
</style>