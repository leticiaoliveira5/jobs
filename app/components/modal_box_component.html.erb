<div class="modal-backdrop fade show d-none" id="backdrop<%= @modal_id %>"></div>

<div class="modal" id="<%= @modal_id %>" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="title<%= @modal_id %>">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title fs-4 fw-bold" id="title<%= @modal_id %>"><%= @title %></h5>
        <button type="button" class="btn-close" aria-label="Fechar" data-modal-close></button>
      </div>
      <div class="modal-body">
        <%= body %>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('<%= @modal_id %>');
    const backdrop = document.getElementById('backdrop<%= @modal_id %>');
    const trigger = document.getElementById('<%= @show_button_id %>');

    const open = () => {
      modal.classList.add('d-block');
      backdrop.classList.remove('d-none');
    };

    const close = () => {
      modal.classList.remove('d-block');
      backdrop.classList.add('d-none');
    };

    if (trigger) trigger.addEventListener('click', open);
    modal.querySelector('[data-modal-close]').addEventListener('click', close);

    // clique fora da caixa (na área escura) fecha
    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && modal.classList.contains('d-block')) close();
    });
  })();
</script>