<div class="fixed inset-0 z-40 hidden bg-black/50" id="backdrop<%= @modal_id %>"></div>

<div class="fixed inset-0 z-50 hidden overflow-y-auto" id="<%= @modal_id %>" tabindex="-1" role="dialog" aria-modal="true" aria-labelledby="title<%= @modal_id %>">
  <div class="mx-2 my-2 sm:mx-auto sm:my-7 sm:max-w-[500px]">
    <div class="flex w-full flex-col rounded-lg border border-black/20 bg-white shadow-lg">
      <div class="flex items-start justify-between p-4 pb-0">
        <h5 class="text-2xl font-bold leading-normal" id="title<%= @modal_id %>"><%= @title %></h5>
        <button type="button" class="cursor-pointer text-2xl leading-none text-black/50 hover:text-black" aria-label="Fechar" data-modal-close>&times;</button>
      </div>
      <div class="p-4">
        <%= body %>
      </div>
    </div>
  </div>
</div>

<script>
  (function () {
    const modal = document.getElementById('<%= @modal_id %>');
    const backdrop = document.getElementById('backdrop<%= @modal_id %>');
    const trigger = document.getElementById('<%= @show_button_id %>');

    const open = () => {
      modal.classList.remove('hidden');
      backdrop.classList.remove('hidden');
    };

    const close = () => {
      modal.classList.add('hidden');
      backdrop.classList.add('hidden');
    };

    if (trigger) trigger.addEventListener('click', open);
    modal.querySelector('[data-modal-close]').addEventListener('click', close);

    modal.addEventListener('click', (event) => {
      if (event.target === modal) close();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !modal.classList.contains('hidden')) close();
    });
  })();
</script>