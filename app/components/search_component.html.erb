<%= form_tag(@path, method: :get) do %>
  <div class="my-1 flex items-stretch">
    <%= text_field_tag @search_param,
                       params[@search_param],
                       class: 'block w-full min-w-0 flex-1 rounded-l-sm border border-primary bg-white px-3 py-1.5 text-sm text-black focus:outline-none focus:ring-2 focus:ring-primary/25',
                       placeholder: t('.search_placeholder'),
                       required: @required,
                       'aria-label': t('.search_placeholder') %>
    <button type="submit"
            class="-ml-px cursor-pointer rounded-r-sm border border-primary px-3 py-1.5 text-sm text-primary hover:bg-primary hover:text-white focus:outline-none focus:ring-2 focus:ring-primary/25"
            aria-label="<%= t('.search_placeholder') %>">
      <i class="fa fa-search"></i>
    </button>
  </div>
<% end %>