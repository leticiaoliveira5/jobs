<div class="rounded-3 p-4 my-3 mx-auto w-100 text-start" style="background-color:<%= bg %>;">
  <% if collapsible? %>
    <div class="d-flex justify-content-between align-items-center fs-4 fw-bold lh-base"
         role="button"
         aria-expanded="<%= expanded? %>"
         aria-controls="<%= collapse_id %>">
      <span><%= title if title? %></span>
      <span class="fs-5 text-secondary" aria-hidden="true"><%= expanded? ? '−' : '+' %></span>
    </div>
  <% elsif title? %>
    <div class="fs-4 fw-bold lh-base"><%= title %></div>
  <% end %>

  <div id="<%= collapse_id %>" class="mt-1 <%= 'd-none' if collapsible? && !expanded? %>">
    <%= body %>
  </div>
</div>

<% if collapsible? %>
  <script>
    (function () {
      const content = document.getElementById('<%= collapse_id %>');
      const toggle = content.previousElementSibling;
      const icon = toggle.lastElementChild;

      toggle.addEventListener('click', () => {
        const open = !content.classList.toggle('d-none');
        toggle.setAttribute('aria-expanded', open);
        icon.textContent = open ? '−' : '+';
      });
    })();
  </script>
<% end %>