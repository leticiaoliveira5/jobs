<div class="mx-auto my-4 w-full rounded-lg p-6 text-start <%= bg_class %>">
  <% if collapsible? %>
    <div class="flex cursor-pointer items-center justify-between text-2xl font-bold leading-normal"
         role="button"
         aria-expanded="<%= expanded? %>"
         aria-controls="<%= collapse_id %>">
      <span><%= title if title? %></span>
      <span class="text-xl text-secondary" aria-hidden="true"><%= expanded? ? '−' : '+' %></span>
    </div>
  <% elsif title? %>
    <div class="text-2xl font-bold leading-normal"><%= title %></div>
  <% end %>

  <div id="<%= collapse_id %>" class="mt-1 <%= 'hidden' if collapsible? && !expanded? %>">
    <%= body %>
  </div>
</div>

<% if collapsible? %>
  <script>
    (function () {
      const content = document.getElementById('<%= collapse_id %>');
      const toggle = content.previousElementSibling;
      const icon = toggle.lastElementChild;

      toggle.addEventListener('click', () => {
        const open = !content.classList.toggle('hidden');
        toggle.setAttribute('aria-expanded', open);
        icon.textContent = open ? '−' : '+';
      });
    })();
  </script>
<% end %>
