<div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center border-0 rounded-2 mt-1 p-3" id="<%= @id %>">
  <span><%= content %></span>
  <span class="fs-5" data-side-button><%= button %></span>
</div>

<% if button? %>
  <script>
    (function () {
      const item = document.currentScript.previousElementSibling;
      const button = item.querySelector('[data-side-button]');
      const largeScreen = window.matchMedia('(min-width: 750px) and (hover: hover)');
      const show = (visible) => button.classList.toggle('invisible', largeScreen.matches && !visible);

      show(false);
      item.addEventListener('mouseenter', () => show(true));
      item.addEventListener('mouseleave', () => show(false));
      item.addEventListener('focusin', () => show(true));
      item.addEventListener('focusout', () => show(false));
    })();
  </script>
<% end %>