<nav class="navbar navbar-expand-md bg-body-secondary px-3 py-0">
  <%= link_to root_path, class: 'navbar-brand text-uppercase fs-1 m-0 py-2' do %>
    <%= @title %>
  <% end %>

  <button class="navbar-toggler border-0"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#<%= collapse_id %>"
          aria-controls="<%= collapse_id %>"
          aria-expanded="false"
          aria-label="Menu">
    <i class="fa fa-bars fs-2"></i>
  </button>

  <div class="collapse navbar-collapse" id="<%= collapse_id %>">
    <div class="navbar-nav me-auto"><%= left %></div>
    <div class="navbar-nav"><%= right %></div>
  </div>
</nav>