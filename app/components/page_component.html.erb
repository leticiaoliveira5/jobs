<div class="page">
  <% if sidebar %>
    <div class="page-sidebar">
      <%= sidebar %>
    </div>
  <% end %>
  <div class="page-content">
    <%= main_content %>
  </div>
</div>

<style>
  .page {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
  };

  .page-sidebar {
    width: 20%;
    padding-right: 1rem;
  };

  .page-content {
    width: 80%;
  };

  @media screen and (min-device-width: 750px) and (min-width: 750px) {
    .page {
      display: flex;
      justify-content: space-between;
      margin: 0 auto;
      max-width: 1200px;
      width: 100%;
    };
    
    .page .page-sidebar {
      width: 28%;
    };
    
    .page .page-content {
      width: 70%;
    };

    .sidebar-avatar {
      margin: 0 auto;
    };
  };

  .sidebar-avatar {
    aspect-ratio: 1;
    border-radius: 50%;
    display: block;
    height: auto;
    max-width: 100%;
    object-fit: cover;
  }
</style>