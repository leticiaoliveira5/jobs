<div class="tabs flex flex-row mb-3 w-full">
  <% tabs.each do |tab| %>
    <div class="tab flex-1 text-center text-gray-500 font-medium text-2xl pt-6 pb-1 border-b-[3px] border-gray-300 cursor-pointer"
         onclick="showTab(event, '<%= tab.id %>')"
         id="defaultOpen">
      <%= tab.title %>
    </div>
  <% end %>
</div>

<% tabs.each do |tab| %>
  <div class="tabcontent mx-auto w-3/4 p-4" id="<%= tab.id %>">
    <%= tab %>
  </div>
<% end %>

<script>
  document.getElementById("defaultOpen").click();

  function showTab(evt, tabName) {
    var i, tabcontent, tab;

    tabcontent = document.getElementsByClassName("tabcontent");
    for (i = 0; i < tabcontent.length; i++) {
      tabcontent[i].style.display = "none";
    }

    tab = document.getElementsByClassName("tab");
    for (i = 0; i < tab.length; i++) {
      tab[i].classList.remove("active", "!border-[#276a66]", "!text-[#276a66]", "font-medium", "tracking-wider");
    }

    document.getElementById(tabName).style.display = "block";
    evt.currentTarget.classList.add("active", "!border-[#276a66]", "!text-[#276a66]", "tracking-wider");
  }
</script>